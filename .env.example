# =====================================================================
#  BEJO STIKER POS - Contoh environment variable untuk VPS
#  Salin ke .env di server:  cp .env.example .env
#  Lalu isi nilainya (jangan pernah commit .env)
# =====================================================================

# --- Wajib ---
# URL publik aplikasi (tanpa garis miring di akhir)
APP_URL=https://bejodigitalprint.com

# API key Gemini (AI Assistant & generator gambar)
GEMINI_API_KEY=

# Proteksi lapis pertama untuk akses dari luar jaringan (Basic Auth browser).
# PENTING: bila REMOTE_ACCESS_PASS kosong, server MENOLAK semua akses dari
# internet (hanya localhost/LAN yang bisa masuk). Isi untuk akses publik.
REMOTE_ACCESS_USER=bejo
REMOTE_ACCESS_PASS=

# --- Opsional ---
# Port internal aplikasi (Caddy meneruskan ke port ini)
PORT=3000

# --- Cloudflare named tunnel (opsional) ---
# Bila diisi, aplikasi juga bisa diakses lewat terowongan dengan URL TETAP.
# Ambil token dari: Cloudflare Dashboard > Zero Trust > Networks > Tunnels > Create
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_PUBLIC_URL=https://app.bejodigitalprint.com

# --- Meta Marketing API (WhatsApp Status Ads) ---
# Ambil dari Meta Business Manager > System Users > Generate Access Token
# Scope token: ads_management, business_management, pages_read_engagement, pages_manage_ads
META_ACCESS_TOKEN=
# Format: act_XXXXXXXXXX (prefix act_ opsional)
META_AD_ACCOUNT_ID=
# Versi Graph API yang dipakai (default v23.0)
META_GRAPH_VERSION=v23.0
# Anggaran harian dikirim apa adanya dalam Rupiah (IDR tidak memakai desimal).
# Akun iklan Meta WAJIB bermata uang IDR; akun mata uang lain ditolak saat publish
# agar nominal tidak salah. META_BUDGET_MULTIPLIER sudah tidak dipakai.

# --- TikTok Marketing API (In-Feed Ads) ---
# Ambil dari TikTok Ads Manager > Tools > TikTok API
# Scope token: advertiser.read, ad.management, creative_upload
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# Wajib untuk objective Konversi (pixel web)
TIKTOK_PIXEL_ID=
# Bid default dalam mata uang akun iklan TikTok (IDR)
TIKTOK_DEFAULT_BID=1000

# --- Shopee Open Platform API (Discovery Ads) ---
# Ambil dari Shopee Open Platform > Console > App > Live credentials
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Access token berlaku 4 jam. Isi refresh token agar server memperbarui token
# otomatis (rotasi disimpan di data/shopee-tokens.json, jangan di-commit).
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
# Shop ID toko yang dipakai bila tidak diisi dari UI
SHOPEE_SHOP_ID=
# Opsional: host sandbox Shopee (default produksi partner.shopeemobile.com)
# SHOPEE_API_BASE=https://partner.test-stable.shopeemobile.com

# URL frontend: development -> http://localhost:8090
#               production  -> https://bejodigitalprint.com/api/pb (di-proxy Caddy)
VITE_POCKETBASE_URL=http://localhost:8090
# DEPRECATED: JANGAN diisi lagi. Kredensial sync kini hanya dibaca server
# (PB_SYNC_EMAIL / PB_SYNC_PASSWORD) dan token dikirim lewat
# POST /api/pocketbase/session.
# Bila sebelumnya pernah diisi, ganti password akun sync di PocketBase karena
# nilai lama sudah ikut ter-bundle ke browser.
# VITE_PB_SYNC_EMAIL=
# VITE_PB_SYNC_PASSWORD=
# (server-side) akun sinkronisasi APLIKASI + URL internal PocketBase
PB_SYNC_EMAIL=<email-akun-sync>
PB_SYNC_PASSWORD=<password-akun-sync>
POCKETBASE_UPSTREAM=http://127.0.0.1:8090

# --- Login DEVELOPER (diverifikasi server, bukan di browser) ---
# Password TIDAK lagi ditanam di bundle. Sesi disimpan sebagai cookie HttpOnly.
DEV_USERNAME=langgo
DEV_PASSWORD=<password-developer-yang-kuat>
# Kunci HMAC untuk cookie sesi developer & Jurnal (string acak 32+ karakter).
# Bila kosong, server memakai JOURNAL_SESSION_SECRET atau PB_ADMIN_PASSWORD.
# Untuk produksi WAJIB diisi agar sesi tidak hilang saat restart.
APP_SESSION_SECRET=<string-acak-minimal-32-karakter>

# --- Modul Jurnal (khusus DEVELOPER) ---
# Akun superuser PocketBase (_superusers). Hanya dipakai server Express untuk
# koleksi jurnal_sheets yang dikunci admin-only. Jangan memakai akun sync aplikasi.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
# Alias lama (opsional, masih didukung): DEV_USERNAME / DEV_PASSWORD di atas
# lebih diutamakan. Nilai harus SAMA dengan kredensial akun DEVELOPER aplikasi.
JOURNAL_DEV_USER=langgo
JOURNAL_DEV_PASSWORD=<sama-dengan-DEV_PASSWORD>
# Fallback lama untuk kunci HMAC; APP_SESSION_SECRET lebih diutamakan.
JOURNAL_SESSION_SECRET=
