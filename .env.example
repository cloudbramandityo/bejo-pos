# =====================================================================
#  BEJO STIKER POS - Contoh environment variable untuk VPS
#  Salin ke .env di server:  cp .env.example .env
#  Lalu isi nilainya (jangan pernah commit .env)
# =====================================================================

# --- Wajib ---
# URL publik aplikasi (tanpa garis miring di akhir)
APP_URL=https://bejodigitalprint.com

# API key Gemini (AI Assistant & generator gambar)
GEMINI_API_KEY=

# Proteksi lapis pertama untuk akses dari luar jaringan (Basic Auth browser)
REMOTE_ACCESS_USER=bejo
REMOTE_ACCESS_PASS=

# --- Opsional ---
# Port internal aplikasi (Caddy meneruskan ke port ini)
PORT=3000

# --- Cloudflare named tunnel (opsional) ---
# Bila diisi, aplikasi juga bisa diakses lewat terowongan dengan URL TETAP.
# Ambil token dari: Cloudflare Dashboard > Zero Trust > Networks > Tunnels > Create
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_PUBLIC_URL=https://app.bejodigitalprint.com

# --- Catatan Firebase ---
# Konfigurasi Firebase (apiKey, projectId, dll) ada di src/firebase.ts
# Pastikan metode sign-in "Anonymous" AKTIF di Firebase Console, karena
# firestore.rules hanya mengizinkan request yang sudah terautentikasi.
