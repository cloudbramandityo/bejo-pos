{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Inventory product item for stickers, printing, and cutting materials",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 64 },
        "imageUrl": { "type": "string" },
        "hargaKulak": { "type": "number" },
        "hargaAgen": { "type": "number" },
        "hargaGrosir": { "type": "number" },
        "hargaUmum": { "type": "number" },
        "hargaMeterGrosir": { "type": "number" },
        "hargaMeterUmum": { "type": "number" },
        "minStock": { "type": "number" },
        "perRollPak": { "type": "string", "maxLength": 100 },
        "dimensions": { "type": "string", "maxLength": 100 },
        "unit": { "type": "string", "maxLength": 32 },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "number" },
        "stockUnit": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id"]
    },
    "ProductCategory": {
      "title": "ProductCategory",
      "description": "Product category classification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "name"]
    },
    "CustomerCategory": {
      "title": "CustomerCategory",
      "description": "Tiered discount customer categories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "discountPercent": { "type": "number" },
        "color": { "type": "string", "maxLength": 32 },
        "minSpend": { "type": "number" }
      },
      "required": ["id", "name", "discountPercent", "color"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact and tier profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 150 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "totalSpent": { "type": "number" },
        "transactionCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "phone", "name", "categoryId"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Sales receipt transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "shiftId": { "type": "string", "maxLength": 128 },
        "cashierName": { "type": "string", "maxLength": 100 },
        "storeName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "timestamp": { "type": "number" },
        "totalQty": { "type": "number" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "change": { "type": "number" },
        "cashierNotes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "shiftId", "date", "total", "paidAmount"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Cashier work shift record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "cashierName": { "type": "string", "maxLength": 100 },
        "storeName": { "type": "string", "maxLength": 100 },
        "startTime": { "type": "string", "maxLength": 64 },
        "endTime": { "type": "string", "maxLength": 64 },
        "startingCash": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "totalCashSales": { "type": "number" },
        "totalTransferSales": { "type": "number" },
        "totalQrisSales": { "type": "number" },
        "transactionCount": { "type": "number" },
        "actualEndingCash": { "type": "number" },
        "cashDifference": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "cashierName", "startTime", "status"]
    },
    "StoreSetting": {
      "title": "StoreSetting",
      "description": "Store configuration and active shift state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "data": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id"]
    },
    "Cashier": {
      "title": "Cashier",
      "description": "Cashier employee records and shift assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "shiftName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "maxLength": 32 },
        "isActive": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "shiftName", "isActive"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "Application user account with role-based authentication",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["DEVELOPER", "ADMIN", "AGEN", "KASIR", "SPK", "OWNER"] },
        "phone": { "type": "string", "maxLength": 32 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "isOnline": { "type": "boolean" },
        "lastActiveAt": { "type": "number" },
        "lastLoginAt": { "type": "number" },
        "spkRoleCategory": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "username", "password", "name", "role", "isActive"]
    },
    "StoreProfile": {
      "title": "StoreProfile",
      "description": "Multi-store and branch store profiles (BEJO Polsek, BEJO Tanon, BEJO Ceweng, BEJO Jombang, BEJO Somet)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 300 },
        "receiptFooter": { "type": "string", "maxLength": 500 },
        "colorTheme": { "type": "string", "maxLength": 32 },
        "isMaster": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "CustomRole": {
      "title": "CustomRole",
      "description": "Custom user role permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "permissions": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Suppliers and vendors directory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "contactPerson": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "Agent": {
      "title": "Agent",
      "description": "Marketing agents and partner affiliates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "contactPerson": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 300 },
        "commissionRate": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "StockTransaction": {
      "title": "StockTransaction",
      "description": "Stock inventory mutation records (in, out, adjustment)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "transactionNumber": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "timestamp": { "type": "number" },
        "type": { "type": "string", "enum": ["IN", "OUT", "OPNAME", "ADJUSTMENT"] },
        "productId": { "type": "string", "maxLength": 128 },
        "productCode": { "type": "string", "maxLength": 64 },
        "productName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 64 },
        "qty": { "type": "number" },
        "unit": { "type": "string", "maxLength": 32 },
        "costPrice": { "type": "number" },
        "totalCost": { "type": "number" },
        "source": { "type": "string", "maxLength": 100 },
        "destination": { "type": "string", "maxLength": 100 },
        "recipient": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "cashierName": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "transactionNumber", "type", "productId", "qty"]
    },
    "UserActivityLog": {
      "title": "UserActivityLog",
      "description": "Audit record of user login and system activities",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 32 },
        "actionType": { "type": "string", "maxLength": 64 },
        "actionTitle": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "number" },
        "formattedDateTime": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "username", "actionType", "actionTitle", "timestamp"]
    },
    "AgentNotification": {
      "title": "AgentNotification",
      "description": "Real-time notification for agent orders (Pengambilan Bahan / Cetak Agen) to notify Admins and Developers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "orderType": { "type": "string", "maxLength": 64 },
        "agentName": { "type": "string", "maxLength": 150 },
        "agentUsername": { "type": "string", "maxLength": 100 },
        "totalQty": { "type": "number" },
        "totalAmount": { "type": "number" },
        "itemsCount": { "type": "number" },
        "itemSummary": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "timestamp": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "orderId", "orderType", "agentName", "timestamp"]
    },
    "Machine": {
      "title": "Machine",
      "description": "Digital printing and cutting machine configuration and availability status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "enum": ["CETAK", "CUTTING", "FINISHING", "OTHER"] },
        "typeDescription": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["READY", "UNDER_MAINTENANCE"] },
        "speed": { "type": "string", "maxLength": 100 },
        "headSpec": { "type": "string", "maxLength": 200 },
        "operatorDefault": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "category", "status"]
    },
    "SpkOrder": {
      "title": "SpkOrder",
      "description": "Digital printing and workflow job ticket order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "timestamp": { "type": "number" },
        "deadlineDate": { "type": "string", "maxLength": 32 },
        "deadlineTime": { "type": "string", "maxLength": 32 },
        "priority": { "type": "string", "enum": ["NORMAL", "URGENT"] },
        "status": { "type": "string", "maxLength": 64 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "customerCategory": { "type": "string", "maxLength": 64 },
        "totalQty": { "type": "number" },
        "totalAreaM2": { "type": "number" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "dpPaid": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "paymentMethod": { "type": "string", "maxLength": 32 },
        "designerName": { "type": "string", "maxLength": 100 },
        "assignedMachine": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "orderNumber", "date", "status", "customerName", "totalAmount"]
    },
    "AiInternalChatMessage": {
      "title": "AiInternalChatMessage",
      "description": "Internal team and AI chat messages synchronized in real-time",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 32 },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "number" },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 150 },
        "senderUsername": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "role", "content"]
    },
    "UserMentionNotification": {
      "title": "UserMentionNotification",
      "description": "Real-time user mention notifications when tagged with @userX",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "messageId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 150 },
        "senderUsername": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "maxLength": 64 },
        "targetUsername": { "type": "string", "maxLength": 100 },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "formattedTime": { "type": "string", "maxLength": 32 },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "messageId", "targetUsername", "content"]
    },
    "PrivateChatMessage": {
      "title": "PrivateChatMessage",
      "description": "Direct 1-on-1 private chat messages between application users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "threadId": { "type": "string", "maxLength": 256 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderUsername": { "type": "string", "maxLength": 100 },
        "senderName": { "type": "string", "maxLength": 150 },
        "recipientUsername": { "type": "string", "maxLength": 100 },
        "recipientName": { "type": "string", "maxLength": 150 },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "number" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "threadId", "senderUsername", "recipientUsername", "content"]
    },
    "PrintingReject": {
      "title": "PrintingReject",
      "description": "Personal printing production reject records (Adjustment, Jamming, Human Error)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 150 },
        "userRole": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "timestamp": { "type": "number" },
        "materialId": { "type": "string", "maxLength": 128 },
        "materialCode": { "type": "string", "maxLength": 64 },
        "materialName": { "type": "string", "maxLength": 200 },
        "unit": { "type": "string", "maxLength": 32 },
        "rejectQty": { "type": "number" },
        "costPerUnit": { "type": "number" },
        "estimatedCostLoss": { "type": "number" },
        "reason": { "type": "string", "maxLength": 64 },
        "reasonDetail": { "type": "string", "maxLength": 1000 },
        "machineId": { "type": "string", "maxLength": 128 },
        "machineName": { "type": "string", "maxLength": 150 },
        "spkOrderNumber": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "userId", "date", "materialId", "rejectQty", "reason"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Proforma and Commercial Invoices with automated status and child invoice tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "documentType": { "type": "string", "maxLength": 32 },
        "documentNumber": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 32 },
        "projectTitle": { "type": "string", "maxLength": 255 },
        "issueDate": { "type": "string", "maxLength": 32 },
        "dueDate": { "type": "string", "maxLength": 32 },
        "grandTotal": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balanceDue": { "type": "number" },
        "paymentScheme": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "documentType", "documentNumber", "status", "grandTotal"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of inventory items"
    },
    "/product_categories/{categoryId}": {
      "schema": "ProductCategory",
      "description": "Product category taxonomy"
    },
    "/customer_categories/{categoryId}": {
      "schema": "CustomerCategory",
      "description": "Customer membership tier categories"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer directory records"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Completed sales transactions"
    },
    "/shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Cashier work shifts"
    },
    "/cashiers/{cashierId}": {
      "schema": "Cashier",
      "description": "Cashiers roster and shift assignment records"
    },
    "/users/{userId}": {
      "schema": "AppUser",
      "description": "POS application user accounts and permissions"
    },
    "/settings/{settingId}": {
      "schema": "StoreSetting",
      "description": "Application settings and operational states"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Supplier contacts and directories"
    },
    "/agents/{agentId}": {
      "schema": "Agent",
      "description": "Sales and marketing agents directory"
    },
    "/stock_transactions/{transactionId}": {
      "schema": "StockTransaction",
      "description": "Stock audit and inventory journal transactions"
    },
    "/activity_logs/{logId}": {
      "schema": "UserActivityLog",
      "description": "User login session and activity audit records"
    },
    "/store_profiles/{profileId}": {
      "schema": "StoreProfile",
      "description": "Multi-store profiles with isolated sales database"
    },
    "/custom_roles/{roleId}": {
      "schema": "CustomRole",
      "description": "Custom permission roles created by Developer/Admin"
    },
    "/agent_notifications/{notificationId}": {
      "schema": "AgentNotification",
      "description": "Real-time notifications for agent orders (Pengambilan Bahan & Cetak Agen)"
    },
    "/spk_orders/{orderId}": {
      "schema": "SpkOrder",
      "description": "Digital printing work ticket SPK orders"
    },
    "/machines/{machineId}": {
      "schema": "Machine",
      "description": "Configurations and availability statuses of production machines"
    },
    "/ai_chat_messages/{messageId}": {
      "schema": "AiInternalChatMessage",
      "description": "Internal team and SI BEJO AI chat messages"
    },
    "/user_mentions/{mentionId}": {
      "schema": "UserMentionNotification",
      "description": "User mention notifications dispatched via @userX tagging"
    },
    "/private_chat_messages/{messageId}": {
      "schema": "PrivateChatMessage",
      "description": "1-on-1 private direct messages exchanged between team members"
    },
    "/printing_rejects/{rejectId}": {
      "schema": "PrintingReject",
      "description": "Personal printing production reject records"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Proforma and Commercial Invoices real-time collection"
    }
  }
}
